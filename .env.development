# API kök adresi (MSW açıkken de aynı adres dinlenir)
VITE_API_BASE_URL=/api
# Gerçek zamanlı kanal (boşsa API adresinden türetilir: ws(s)://<host>/api/realtime)
VITE_REALTIME_URL=
# true: tarayıcıda MSW worker başlar, tüm API mock'lanır
VITE_API_MOCKING=true
# development | test | staging | production
VITE_APP_ENV=development
